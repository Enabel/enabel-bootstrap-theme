{
  "extends": [
    "stylelint-config-twbs-bootstrap"
  ],
  "rules": {
    "selector-no-qualifying-type": null,
    "declaration-no-important": null,
    "scss/at-function-named-arguments": [
      "never",
      {
        "ignoreFunctions": [
          "/^color\\.scale$/"
        ]
      }
    ]
  }
}

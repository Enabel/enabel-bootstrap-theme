{
  "name": "@enabel/enabel-bootstrap-theme",
  "version": "4.0.0",
  "description": "Custom Bootstrap theme for Enabel applications with CSS and JavaScript components",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "webpack --mode=production --config-node-env=production",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "stylelint 'scss/**/*.scss'",
    "astro": "astro"
  },
  "keywords": [
    "enabel",
    "bootstrap",
    "theme",
    "css",
    "scss",
    "frontend",
    "ui",
    "components"
  ],
  "author": "damien.lagae@enabel.be",
  "license": "MIT",
  "main": "dist/css/enabel-bootstrap-theme.min.css",
  "sass": "scss/enabel-bootstrap-theme.scss",
  "style": "dist/css/enabel-bootstrap-theme.min.css",
  "exports": {
    ".": {
      "style": "./dist/css/enabel-bootstrap-theme.min.css",
      "sass": "./scss/enabel-bootstrap-theme.scss",
      "default": "./dist/css/enabel-bootstrap-theme.min.css"
    },
    "./css": "./dist/css/enabel-bootstrap-theme.min.css",
    "./scss": "./scss/enabel-bootstrap-theme.scss"
  },
  "files": [
    "dist/",
    "fonts/",
    "scss/",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "astro": "^7.4.1",
    "autoprefixer": "^10.4",
    "clean-webpack-plugin": "^4.0",
    "copy-webpack-plugin": "^14.0",
    "css-loader": "^7.1.1",
    "flag-icons": "^7.5.0",
    "mini-css-extract-plugin": "^2.9",
    "postcss": "^8.4",
    "postcss-loader": "^8.1",
    "prettier": "^3.2",
    "prettier-plugin-astro": "^1.1",
    "sass": "^1.92",
    "sass-loader": "^17.0",
    "style-loader": "^4.0",
    "stylelint": "^16.26",
    "stylelint-config-twbs-bootstrap": "^16.1",
    "typescript": "^7.0.2",
    "webpack": "^5.91",
    "webpack-cli": "^7.2"
  },
  "dependencies": {
    "@popperjs/core": "^2.11",
    "bootstrap": "^5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enabel/enabel-bootstrap-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Enabel/enabel-bootstrap-theme/issues"
  },
  "homepage": "https://github.com/Enabel/enabel-bootstrap-theme#readme",
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
